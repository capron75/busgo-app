// use prisma-8

enum BookingStatus {
  @@type("pg/text@1")
  PENDING   = "PENDING"
  CONFIRMED = "CONFIRMED"
  CANCELLED = "CANCELLED"
}

model User {
  id            String    @id
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  bookings      Booking[]
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime  @default(now()) @onCreate(now())
  updatedAt     temporal.UpdatedAt
}

model Route {
  id          String   @id @onCreate(uuid())
  origin      String
  destination String
  buses       Bus[]
  createdAt   DateTime @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Bus {
  id        String   @id @onCreate(uuid())
  name      String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)
  routeId   String
  seats     Seat[]
  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Seat {
  id        String    @id @onCreate(uuid())
  number    String
  isBooked  Boolean   @default(false)
  bus       Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  busId     String
  bookings  Booking[]
  createdAt DateTime  @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@unique([busId, number])
}

model Booking {
  id          String        @id @onCreate(uuid())
  bookingDate DateTime
  status      BookingStatus @default(PENDING)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  seat        Seat          @relation(fields: [seatId], references: [id], onDelete: Restrict)
  seatId      String
  createdAt   DateTime      @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @onCreate(now())
  updatedAt             temporal.UpdatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}
